import re
import textwrap

file_path = "/data/data/com.termux/files/home/InloopID/backend/routes.py"

with open(file_path, 'r') as f:
    content = f.read()

# Vytvoření zálohy
with open(file_path + ".bak_fpdf", 'w') as f:
    f.write(content)

# Bezpečné odstranění staré funkce
content = re.sub(r"@api_bp\.route\('/hr/compliance-report/pdf'.*?(?=@api_bp\.route|\Z)", "", content, flags=re.DOTALL)

# Nová funkce s podporou UTF-8 fontů a českou diakritikou
new_code = """
@api_bp.route('/hr/compliance-report/pdf', methods=['GET'])
def compliance_report_pdf():
    from flask import request, send_file, current_app
    from models import VerifiableCredentialAnchor, CompanyWorkspace
    from fpdf import FPDF
    import tempfile, os
    from datetime import datetime, UTC

    tenant_id = request.args.get('tenant_id')
    if not tenant_id:
        return "Chybí tenant_id", 400

    comp = CompanyWorkspace.query.filter_by(tenant_id=tenant_id).first()
    company_name = comp.company_name if comp else tenant_id
    credentials = VerifiableCredentialAnchor.query.filter_by(tenant_id=tenant_id).order_by(VerifiableCredentialAnchor.created_at.desc()).all()
    
    safe = 0; risk = 0; pending = 0
    now = datetime.now(UTC)

    for cred in credentials:
        if cred.status in ['anchored', 'pending_signature']:
            pending += 1
        elif cred.status == 'signed':
            delta = now - cred.created_at.replace(tzinfo=UTC)
            if delta.days <= 7: risk += 1
            else: safe += 1

    pdf = FPDF()
    
    # --- PŘIDÁNÍ UNICODE FONTU ROBOTO ---
    font_dir = os.path.join(current_app.root_path, 'static', 'fonts')
    os.makedirs(font_dir, exist_ok=True)
    
    pdf.add_font('Roboto', '', os.path.join(font_dir, 'Roboto-Regular.ttf'), uni=True)
    pdf.add_font('Roboto', 'B', os.path.join(font_dir, 'Roboto-Bold.ttf'), uni=True)
    
    pdf.add_page()
    
    # Texty s plnou českou diakritikou
    pdf.set_font("Roboto", "B", 16)
    pdf.cell(0, 10, "INLOOPID - KRYPTOGRAFICKÝ AUDIT (SLEPÝ NOTÁŘ)", ln=True, align="C")
    pdf.ln(10)
    
    pdf.set_font("Roboto", "B", 12)
    pdf.cell(0, 8, f"Subjekt: {company_name}", ln=True)
    pdf.set_font("Roboto", "", 10)
    pdf.cell(0, 6, f"ID (Tenant): {tenant_id}", ln=True)
    pdf.cell(0, 6, f"Vygenerováno: {now.strftime('%d.%m.%Y %H:%M:%S')} UTC", ln=True)
    pdf.ln(10)

    pdf.set_font("Roboto", "B", 12)
    pdf.cell(0, 8, "SOUHRN PRÁVNÍHO RADARU:", ln=True)
    pdf.set_font("Roboto", "", 10)
    pdf.cell(0, 6, f"Dokumenty čekající na podpis: {pending}", ln=True)
    pdf.cell(0, 6, f"Dokumenty v ochranné lhůtě (do 7 dnů): {risk}", ln=True)
    pdf.cell(0, 6, f"Nedotknutelné / Uzavřené dokumenty: {safe}", ln=True)
    pdf.ln(10)

    pdf.set_font("Roboto", "B", 12)
    pdf.cell(0, 8, "KRYPTOGRAFICKÝ ZÁZNAM (Nulová Znalost):", ln=True)
    pdf.set_font("Roboto", "", 8)
    
    for cred in credentials:
        hash_short = f"{cred.content_hash[:20]}..." if cred.content_hash else "HASH_PENDING"
        pdf.cell(0, 5, f"ID: {cred.credential_id} | DID: {cred.subject_did}", ln=True)
        pdf.cell(0, 5, f"    STATUS: {cred.status.upper()} | HASH: {hash_short}", ln=True)
        pdf.ln(2)

    fd, temp_path = tempfile.mkstemp(suffix=".pdf")
    os.close(fd)
    pdf.output(temp_path)

    return send_file(temp_path, as_attachment=True, download_name=f"InLoopID_Audit_{tenant_id}.pdf")
"""

with open(file_path, 'w') as f:
    f.write(content.strip() + "\n\n" + textwrap.dedent(new_code).strip() + "\n")

print("[+] API pro PDF audit bylo aktualizováno a je chráněno proti UTF-8 pádům.")
