import subprocess, json, base64, time, os, smtplib, hashlib, traceback, secrets, threading, tempfile
import requests
from email.message import EmailMessage
from datetime import datetime, timedelta, UTC
from tasks import send_invitations_task, send_contract_notice_task
from flask import Blueprint, request, jsonify, redirect, session, current_app
from models import db, CompanyWorkspace, IdentityNode, VerifiableCredentialAnchor, BlindAuditLog, HRAgendaItem, OnboardingTask, Invitation

api_bp = Blueprint('api', __name__, url_prefix='/api/v1')

def get_qualified_timestamp(data_hash):
    tsa_url = "https://freetsa.org/tsr"
    try:
        with tempfile.NamedTemporaryFile(delete=False) as f_query:
            query_path = f_query.name

        subprocess.run([
            'openssl', 'ts', '-query',
            '-digest', data_hash,
            '-sha256',
            '-cert',
            '-out', query_path
        ], check=True, capture_output=True)

        with open(query_path, 'rb') as f:
            tsq_data = f.read()
        os.remove(query_path)

        headers = {'Content-Type': 'application/timestamp-query'}
        response = requests.post(tsa_url, data=tsq_data, headers=headers, timeout=10)

        if response.status_code == 200 and response.headers.get('Content-Type') == 'application/timestamp-reply':
            tsr_base64 = base64.b64encode(response.content).decode('utf-8')
            return f"eIDAS_TSR_BASE64:{tsr_base64}"
        else:
            raise Exception(f"TSA server vrátil chybu: {response.status_code}")
    except Exception as e:
        print(f"[TSA CHYBA] Nelze získat eIDAS razítko: {e}")
        return f"TSA_QUALIFIED_TOKEN_{data_hash[:8]}_{datetime.now(UTC).isoformat()}"

def send_invitation_emails_async(invitations, company_name, smtp_server, smtp_port, smtp_user, smtp_pass):
    try:
        if int(smtp_port) == 465: server = smtplib.SMTP_SSL(smtp_server, int(smtp_port))
        else:
            server = smtplib.SMTP(smtp_server, int(smtp_port))
            server.starttls()
        server.login(smtp_user, smtp_pass)
        for email, link in invitations:
            msg = EmailMessage()
            msg['Subject'] = f'Pozvánka do Onboarding portálu: {company_name}'
            msg['From'] = smtp_user
            msg['To'] = email
            html_content = f"""<html><body style="font-family: Arial, sans-serif; background-color: #020617; color: #ffffff; padding: 40px; text-align: center;"><div style="max-width: 600px; margin: 0 auto; background-color: #0f172a; padding: 40px; border-radius: 24px; border: 1px solid #1e293b; box-shadow: 0 10px 25px rgba(0,0,0,0.5);"><h2 style="color: #f8fafc; font-size: 24px; margin-bottom: 10px;">Vítejte v InLoopID</h2><p style="color: #94a3b8; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">Společnost <strong style="color: #ffffff;">{company_name}</strong> Vám zaslala pozvánku do bezpečného HR portálu.</p><a href="{link}" style="display: inline-block; background-color: #2563eb; color: #ffffff; padding: 16px 32px; text-decoration: none; border-radius: 12px; font-weight: bold; font-size: 16px; transition: background-color 0.3s;">Odemknout Trezor přes MojeID</a></div></body></html>"""
            msg.set_content(f"Dobrý den,\nSpolečnost {company_name} Vás zve do HR portálu.\nOdkaz: {link}")
            msg.add_alternative(html_content, subtype='html')
            server.send_message(msg)
        server.quit()
    except Exception as e:
        print(f"[SMTP CHYBA] {str(e)}")

@api_bp.route('/health', methods=['GET'])
def health_check(): return jsonify({"status": "healthy"}), 200

@api_bp.route('/mojeid/login', methods=['GET'])
def mojeid_login():
    claims_req = json.dumps({"userinfo": {"given_name": {"essential": True}, "family_name": {"essential": True}, "birthdate": None, "address": None}})
    return current_app.config['OAUTH_REGISTRY'].mojeid.authorize_redirect('http://localhost:5000/api/v1/mojeid/callback', claims=claims_req, scope='openid profile email address', prompt='login')

@api_bp.route('/mojeid/callback')
def mojeid_callback():
    oauth = current_app.config['OAUTH_REGISTRY']
    try:
        token = oauth.mojeid.authorize_access_token()
        userinfo = oauth.mojeid.userinfo()
        email = userinfo.get('email')
        if not email: raise ValueError("MojeID neposkytlo povinný e-mail.")
        email_hash = hashlib.sha256(email.encode('utf-8')).hexdigest()
        existing_node = IdentityNode.query.filter_by(email_hash=email_hash).first()
        restore_mode = "true" if existing_node else "false"
        raw_address = userinfo.get('address', '')
        formatted_address = raw_address.get('formatted', '') if isinstance(raw_address, dict) else str(raw_address)
        claims = {
            "email": email, "email_hash": email_hash,
            "first_name": userinfo.get('given_name', ''), "last_name": userinfo.get('family_name', ''),
            "birthdate": userinfo.get('birthdate', ''), "address": formatted_address,
            "encrypted_keystore": existing_node.encrypted_keystore if existing_node else None,
            "keystore_iv": existing_node.keystore_iv if existing_node else None, "exp": time.time() + 300
        }
        token_b64 = base64.b64encode(json.dumps(claims).encode('utf-8')).decode('utf-8')
        return redirect(f"http://localhost:5173/employee?mojeid_token={token_b64}&restore={restore_mode}")
    except Exception as e:
        return redirect(f"http://localhost:5173/employee?error=auth_failed_{str(e).replace(' ', '_')}")

@api_bp.route('/eidas/issue-identity', methods=['POST'])
def eidas_issue_identity():
    data = request.get_json()
    claims = json.loads(base64.b64decode(data['mojeid_token']).decode('utf-8'))
    identity_credential = {"context": "https://www.w3.org/2018/credentials/v1", "type": ["VerifiableCredential", "MojeIDVerifiedIdentity"], "issuer": "did:web:inloopid.com:notary", "credentialSubject": { "id": data['did_uri'], "identityProvider": "mojeid", "verifiedClaims": claims }}
    db.session.add(BlindAuditLog(action='EIDAS_ISSUED', actor_did=data['did_uri']))
    db.session.commit()
    return jsonify({"status": "success", "credential": identity_credential}), 201

@api_bp.route('/register-identity', methods=['POST'])
def register_identity():
    data = request.get_json()
    identity = IdentityNode.query.filter_by(did_uri=data['did_uri']).first()
    if not identity:
        db.session.add(IdentityNode(tenant_id=data.get('tenant_id', 'public_zone'), did_uri=data['did_uri'], email_hash=data.get('email_hash'), public_key_jwk=data.get('public_key_jwk'), encrypted_keystore=data.get('encrypted_keystore'), keystore_iv=data.get('keystore_iv'), role='user'))
        db.session.commit()
    return jsonify({"status": "success"}), 200

@api_bp.route('/b2b/register', methods=['POST'])
def register_company():
    data = request.get_json()
    tenant_id = data.get('tenant_id')
    plan = data.get('subscription_plan', 'trial')
    if CompanyWorkspace.query.filter_by(tenant_id=tenant_id).first(): return jsonify({"error": "Tato firma již existuje."}), 400
    db.session.add(CompanyWorkspace(tenant_id=tenant_id, company_name=data.get('company_name'), ico=data.get('ico'), admin_email=data.get('admin_email'), public_key_jwk=data.get('public_key_jwk', ''), encrypted_private_key=data.get('encrypted_private_key', ''), private_key_iv=data.get('private_key_iv', ''), subscription_plan=plan, subscription_status='active'))
    db.session.add(BlindAuditLog(action=f'B2B_TENANT_CREATED_{tenant_id}_PLAN_{plan.upper()}', actor_did='system'))
    db.session.commit()
    return jsonify({"status": "success", "tenant_id": tenant_id}), 201

@api_bp.route('/lookup-identity', methods=['POST'])
def lookup_identity():
    data = request.get_json()
    email_hash = hashlib.sha256(data.get('email', '').encode('utf-8')).hexdigest()
    identity = IdentityNode.query.filter_by(email_hash=email_hash).first()
    if not identity: return jsonify({"error": "Nenalezeno."}), 404
    return jsonify({"status": "success", "did_uri": identity.did_uri, "public_key_jwk": identity.public_key_jwk, "created_at": identity.created_at.isoformat()}), 200

@api_bp.route('/anchor-credential', methods=['POST'])
def anchor_credential():
    data = request.get_json()
    
    required_keys = ['credential_id', 'issuer_did', 'subject_did', 'content_hash', 'proof_signature', 'encrypted_payload', 'iv', 'wrapped_key']
    if not all(key in data for key in required_keys):
        return jsonify({"error": "missing required cryptographic fields"}), 400

    
    # Slepé přijetí: Server neověřuje identitu v DB, pouze validuje strukturu payloadu.
    # Toto zabraňuje útoku typu "Entity Enumeration".
    db.session.add(VerifiableCredentialAnchor(
        tenant_id=data.get('tenant_id', 'public_zone'), 
        credential_id=data['credential_id'], 
        issuer_did=data['issuer_did'], 
        subject_did=data['subject_did'],
        content_hash=data['content_hash'], 
        proof_signature=data['proof_signature'],
        hr_tsa_token=get_qualified_timestamp(data['content_hash']), 
        encrypted_payload=data['encrypted_payload'], 
        iv=data['iv'], 
        wrapped_key=data['wrapped_key'],
        status='pending_signature'
    ))
    db.session.commit()

    return jsonify({"status": "success", "credential": identity_credential}), 201

