import React, { useState, useEffect } from 'react';
import { ShieldCheck, FileText, X, User, Archive, AlertOctagon, PenTool, Download } from 'lucide-react';
import { notify } from './ToastManager';

const BACKEND_URL = 'http://localhost:5000/api/v1';

export const EmployeeDashboard = () => {
  const [token, setToken] = useState(null);
  const [vaultData, setVaultData] = useState(null);
  const [selectedDoc, setSelectedDoc] = useState(null);
  const [mojeIdClaims, setMojeIdClaims] = useState({});

  useEffect(() => {
    const urlToken = new URLSearchParams(window.location.search).get('mojeid_token') || localStorage.getItem('employee_token');
    if (urlToken) {
        localStorage.setItem('employee_token', urlToken);
        setToken(urlToken);
        try { 
            const base64Url = urlToken.split('.')[1] || urlToken;
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            setMojeIdClaims(JSON.parse(window.atob(base64))); 
        } catch(e) { console.error("Chyba parsování tokenu", e); }
    }
  }, []);

  useEffect(() => { if (token) fetchVault(); }, [token]);

  const fetchVault = async () => {
      try {
          const res = await fetch(`${BACKEND_URL}/employee/vault`, { headers: { 'Authorization': `Bearer ${token}` } });
          const data = await res.json();
          setVaultData(data);
      } catch (e) { notify.error("Chyba spojení"); }
  };

  return (
      <div className="min-h-screen bg-slate-950 p-6 text-white">
          <h1 className="text-2xl font-bold mb-6">Můj Pracovní Trezor</h1>
          <div className="grid gap-4">
              {vaultData?.documents.map(doc => (
                  <div key={doc.id} onClick={() => setSelectedDoc(doc)} className="bg-slate-900 p-6 rounded-2xl border border-slate-800 cursor-pointer hover:border-blue-500">
                      <p className="font-bold">Smlouva ID: {doc.id}</p>
                      <p className="text-xs text-slate-500">Status: {doc.status}</p>
                  </div>
              ))}
          </div>

          {selectedDoc && (
              <div className="fixed inset-0 bg-slate-950/95 p-6 flex justify-center items-center overflow-y-auto z-50">
                  <div className="bg-slate-900 w-full max-w-2xl p-8 rounded-3xl border border-slate-700">
                      <div className="flex justify-between mb-6">
                          <h2 className="text-xl font-bold">Detail smlouvy</h2>
                          <button onClick={() => setSelectedDoc(null)}><X /></button>
                      </div>
                      
                      <div className="bg-slate-950 p-6 rounded-xl font-mono text-sm space-y-3 border border-slate-800">
                          {(() => {
                              try {
                                  const raw = atob(selectedDoc.encrypted_payload);
                                  const p = JSON.parse(raw);
                                  return (
                                      <div className="space-y-2">
                                          <p><strong>Zaměstnanec:</strong> {p.employeeName || (mojeIdClaims.first_name + ' ' + mojeIdClaims.last_name)}</p>
                                          <p><strong>Pozice:</strong> {p.position}</p>
                                          <p><strong>Mzda:</strong> {p.salary}</p>
                                          <p><strong>Nástup:</strong> {p.startDate}</p>
                                          <p><strong>Doba:</strong> {p.duration === 'urcita' ? 'Určitá do ' + p.validUntil : 'Neurčitá'}</p>
                                          {p.type === 'HPP' && (
                                              <>
                                                  <p><strong>Zkušební doba:</strong> {p.probationPeriod} měs.</p>
                                                  <p><strong>Úvazek:</strong> {p.workingHours} h/týd.</p>
                                                  <p><strong>Dovolená:</strong> {p.vacationDays} dnů</p>
                                              </>
                                          )}
                                          <div className="mt-6 p-4 bg-blue-900/20 border border-blue-500/30 rounded-lg text-[11px] leading-relaxed">
                                              {p.legalClauses}
                                          </div>
                                      </div>
                                  );
                              } catch(e) {
                                  return <div className="text-rose-500">Chyba vykreslení payloadu: {e.message}</div>;
                              }
                          })()}
                      </div>
                      <button onClick={() => setSelectedDoc(null)} className="mt-8 w-full py-4 bg-slate-800 rounded-xl font-bold">Zavřít</button>
                  </div>
              </div>
          )}
      </div>
  );
};
