import React, { useState, useEffect, useLayoutEffect } from 'react';
import { ShieldCheck, Lock, Database, Award, Briefcase, User, Send, Fingerprint, FileSignature, Scale, FileCheck, Search, Mail, MapPin, Clock, CheckCircle, Loader2, Check, Key, Unlock, Eye, EyeOff, Laptop, Server, Archive, AlertTriangle, Play, Menu, X, FilePlus, PenTool, Activity, Users, Shield, ChevronLeft, ChevronRight, FileText, Calculator, TrendingDown, Clock3, AlertOctagon, Wand2, Zap } from 'lucide-react';
import { Link } from 'react-router-dom';

const BentoCard = ({ children, className }) => {
  const [pos, setPos] = useState({ x: 0, y: 0 });
  const [opacity, setOpacity] = useState(0);
  
  const handleMouseMove = (e) => {
    const rect = e.currentTarget.getBoundingClientRect();
    setPos({ x: e.clientX - rect.left, y: e.clientY - rect.top });
  };
  
  return (
    <div onMouseMove={handleMouseMove} onMouseEnter={() => setOpacity(1)} onMouseLeave={() => setOpacity(0)} className={`anim-card relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white/50 backdrop-blur-sm shadow-sm transition-all duration-500 hover:shadow-xl hover:-translate-y-1 ${className}`}>
      <div className="pointer-events-none absolute -inset-px transition-opacity duration-300 z-0" style={{ opacity, background: `radial-gradient(600px circle at ${pos.x}px ${pos.y}px, rgba(30,58,138,0.08), transparent 40%)` }}/>
      <div className="relative z-10 h-full p-10 flex flex-col items-start text-left">{children}</div>
    </div>
  );
};

const UnifiedBentoGrid = () => {
